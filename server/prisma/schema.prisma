generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  student
  teacher
}

enum CourseRole {
  student
  teacher
}

enum EntryStatus {
  draft
  submitted
  reviewed
}

enum EntryKind {
  practice
  teaching_lesson
}

enum ConsentScope {
  private_course_review
}

enum CaptureProfile {
  room_overview
  teacher_learner
  instrument_closeup
  ensemble_group
  group_work
}

enum CaptureMarkerKind {
  phase_setup
  phase_modeling
  phase_guided_practice
  phase_student_work
  phase_feedback
  phase_reflection
  moment_question
  moment_musical_model
  moment_student_response
  moment_transition
  privacy_note
}

enum ArtifactType {
  audio
  video
}

enum UploadState {
  pending
  uploading
  uploaded
  failed
}

enum FeedbackStatus {
  ok
  needs_revision
  next_goal
}

enum FeedbackTargetType {
  entry
  artifact
}

// ── CASCADE DELETE implications ─────────────────────────────────────
// All child relations use `onDelete: Cascade`.  This means:
//
//   Deleting a User  → removes their Memberships, PracticeEntries,
//                       Feedback (authored), RefreshTokens, and
//                       transitively all Artifacts, Markers.
//   Deleting a Course → removes Memberships and PracticeEntries
//                        (with their Artifacts, Feedback, Markers).
//
// These cascades can remove large amounts of data in a single
// operation with no undo.  In production, consider:
//   1. Soft-delete users/courses (set a `deletedAt` timestamp)
//      before hard-deleting, with a grace period.
//   2. Exporting or archiving data before deletion.
//   3. Restricting hard-delete to an admin-only maintenance path
//      that requires explicit confirmation.
// ────────────────────────────────────────────────────────────────────

model User {
  id          String        @id
  displayName String
  globalRole  GlobalRole
  memberships Membership[]
  entries     PracticeEntry[] @relation("StudentEntries")
  feedback    Feedback[]
  captureMarkers CaptureMarker[]
  refreshTokens RefreshToken[]
}

model Course {
  id          String        @id
  title       String
  memberships Membership[]
  entries     PracticeEntry[]
}

model Membership {
  userId   String
  courseId String
  roleInCourse CourseRole
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model PracticeEntry {
  id              String      @id
  courseId        String
  studentId       String
  createdAt       DateTime    @default(now())
  kind            EntryKind   @default(practice)
  practiceDate    DateTime
  goalText        String
  durationSeconds Int?
  tags            String[]
  notes           String?
  status          EntryStatus @default(draft)
  consentConfirmedAt DateTime?
  consentScope    ConsentScope?
  captureProfile  CaptureProfile?
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation("StudentEntries", fields: [studentId], references: [id], onDelete: Cascade)
  artifacts Artifact[]
  feedback  Feedback[]
  captureMarkers CaptureMarker[]

  @@index([courseId])
  @@index([studentId])
  @@index([status])
  @@index([courseId, deletedAt])
}

model Artifact {
  id              String      @id
  entryId         String
  type            ArtifactType
  durationSeconds Int
  createdAt       DateTime    @default(now())
  uploadState     UploadState @default(pending)
  storageKey      String?
  remoteUrl       String?

  entry PracticeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  captureMarkers CaptureMarker[]

  @@index([entryId])
}

model CaptureMarker {
  id          String            @id
  entryId     String
  artifactId  String
  studentId   String
  timeSeconds Int
  kind        CaptureMarkerKind
  note        String?
  createdAt   DateTime          @default(now())

  entry    PracticeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  artifact Artifact      @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  student  User          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([artifactId])
  @@index([studentId])
}

model Feedback {
  id          String      @id
  targetType  FeedbackTargetType
  targetId    String
  teacherId   String
  entryId     String?
  createdAt   DateTime    @default(now())
  status      FeedbackStatus
  commentsText String

  teacher User @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  entry   PracticeEntry? @relation(fields: [entryId], references: [id], onDelete: Cascade)
  markers Marker[]

  @@index([targetId, targetType])
  @@index([teacherId])
  @@index([entryId])
}

model Marker {
  id          String   @id
  feedbackId  String
  timeSeconds Int
  text        String

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
}

model RefreshToken {
  id         String   @id
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
