# ── Resonance Server Environment ─────────────────────────────────────
# Copy to .env and fill in real values before running the server.
#
# WARNING: Do NOT use these placeholder values in production.
# Generate strong, unique secrets for every deployment.
# ─────────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://resonance:resonance@localhost:5432/resonance
PORT=4000

# SECURITY: Replace with a strong random secret (>= 32 chars).
# Generate one with:  openssl rand -base64 48
JWT_SECRET=CHANGE-ME-generate-a-real-secret-at-least-32-chars

# Optional: separate signing key for refresh tokens.
# Defaults to JWT_SECRET + '-refresh' if not set.
# For production, generate a distinct secret:  openssl rand -base64 48
# JWT_REFRESH_SECRET=CHANGE-ME-generate-a-different-secret

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# WARNING: "dev" disables real authentication — use ONLY on localhost.
# In any reachable environment, set AUTH_MODE=prod and configure real SSO.
AUTH_MODE=dev
DEV_UNIVERSITY_NAME=Mock University Conservatory

# ── Object Storage (S3 / MinIO) ─────────────────────────────────────
# The defaults below are for a local MinIO instance (docker-compose).
# SECURITY: Replace access/secret keys for any non-local deployment.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=resonance-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=900

# ── OAuth / Callback ────────────────────────────────────────────────
DEV_LOGIN_CALLBACK_URL=resonance://auth-callback
APP_BASE_URL=http://localhost:4000

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated origins. Empty = fail-closed (no cross-origin).
# CORS_ORIGINS=https://app.example.com

# ── Production SSO (OIDC) ────────────────────────────────────────────
# Required when AUTH_MODE=prod. Set to your university IdP's OIDC issuer.
# The IdP must support OIDC discovery (RFC 8414).
#
# Shibboleth example (via SATOSA OIDC proxy or native OIDC support):
#   OIDC_DISCOVERY_URL=https://sso.university.de/.well-known/openid-configuration
#
# Register a client in your IdP console and set:
#   OIDC_CLIENT_ID=resonance
#   OIDC_CLIENT_SECRET=<client-secret-from-idp>
#   OIDC_REDIRECT_URI=https://<your-api-domain>/auth/oidc/callback
#
# Role mapping (optional):
#   OIDC_ROLE_CLAIM=role              # claim name that carries the user role
#   OIDC_TEACHER_VALUE=teacher        # claim value that means "teacher"
#   (all other values → student)
#
# OIDC_DISCOVERY_URL=https://sso.university.de/.well-known/openid-configuration
# OIDC_CLIENT_ID=resonance
# OIDC_CLIENT_SECRET=CHANGE-ME
# OIDC_REDIRECT_URI=https://api.university.de/auth/oidc/callback
# OIDC_ROLE_CLAIM=role
# OIDC_TEACHER_VALUE=teacher
