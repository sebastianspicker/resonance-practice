{
  "name": "resonance-server",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Fastify API for the Resonance offline-first music-education alpha.",
  "license": "MIT",
  "homepage": "https://github.com/sebastianspicker/resonance#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastianspicker/resonance.git",
    "directory": "server"
  },
  "bugs": {
    "url": "https://github.com/sebastianspicker/resonance/issues"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist node_modules .vitest coverage test-results",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "quality": "npm run lint && npm run quality:dead-code && npm run quality:duplicates",
    "quality:dead-code": "knip --config knip.json --no-progress --treat-config-hints-as-errors",
    "quality:duplicates": "jscpd --config .jscpd.json --no-colors --no-tips src tests prisma ../ios/ResonanceApp/Sources ../ios/ResonanceApp/Tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"prisma/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"prisma/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "prisma:seed:demo": "tsx prisma/seed.demo.ts",
    "demo:reset": "tsx prisma/reset.demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1038.0",
    "@aws-sdk/s3-request-presigner": "3.1038.0",
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@prisma/client": "5.22.0",
    "dotenv": "17.3.1",
    "fastify": "5.8.5",
    "jsonwebtoken": "9.0.3",
    "nanoid": "5.1.7",
    "openid-client": "5.7.1",
    "prisma": "5.22.0"
  },
  "overrides": {
    "fast-xml-builder": "1.2.0",
    "fast-xml-parser": "5.7.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.13.2",
    "@types/supertest": "7.2.0",
    "@typescript-eslint/eslint-plugin": "8.57.2",
    "@typescript-eslint/parser": "8.57.2",
    "@vitest/coverage-v8": "4.1.1",
    "aws-sdk-client-mock": "3.1.0",
    "eslint": "9.39.4",
    "globals": "17.4.0",
    "jscpd": "5.0.12",
    "knip": "6.27.0",
    "prettier": "3.8.1",
    "supertest": "7.2.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.1"
  }
}
